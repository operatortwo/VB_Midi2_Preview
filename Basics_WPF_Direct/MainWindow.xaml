<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Basics_WPF_Direct"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="860" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <TextBox HorizontalAlignment="Center" Margin="0,21,0,0" TextWrapping="Wrap" Text="Testing the the programmatic requiremnts to access the upcoming Midi2 Service &#xA;on Windows. Do not expect that any Midi2 function work, unless you are  an &#xA;advanced Developer and have installed the Midi2 SDK.&#xA;Other developers and users should wait until the official roll-out.&#xA;" VerticalAlignment="Top" Width="438" Height="72" IsReadOnly="True" Background="#FFFBF8E5"/>
        <Label Content="Message:" HorizontalAlignment="Left" Margin="44,130,0,0" VerticalAlignment="Top" Padding="5,0,5,0"/>
        <TextBox x:Name="TbMessage" Margin="44,151,39,97" TextWrapping="Wrap" IsReadOnly="True" Background="#FFFBFBFF" Padding="5,5,5,5" VerticalScrollBarVisibility="Auto"/>
        <Button Content="Close" HorizontalAlignment="Center" Margin="0,519,0,0" Width="94" Background="#FFDBE6F9" IsCancel="True" Click="Button_Click" Height="30" VerticalAlignment="Top"/>
        <Button x:Name="BtnSendMsg" Content="Send Message" HorizontalAlignment="Left" Margin="415,118,0,0" VerticalAlignment="Top" Width="96" IsEnabled="False"/>

    </Grid>
</Window>
