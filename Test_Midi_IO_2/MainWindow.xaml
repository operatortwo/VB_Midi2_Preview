<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test_Midi_IO_2"
        mc:Ignorable="d"
        Title="Test Midi_IO_2" Height="600" Width="900" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <TabControl x:Name="TabControl1">
            <TabItem x:Name="TiEndpointWatcher" Header="Endpoint Watcher">
                <Grid>
                    <Button x:Name="BtnClose" Content="Close" Margin="133,0,0,63" IsCancel="True" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="50" Background="#FFE0F1FF"/>
                    <TextBox x:Name="TbMessage" HorizontalAlignment="Left" Margin="100,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="231" Height="189" IsReadOnly="True"/>
                    <ListBox x:Name="LbMidiOutput" Margin="0,30,61,186" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalAlignment="Right" Width="272" />
                    <ListBox x:Name="LbMidiInput" Margin="0,0,61,25" d:ItemsSource="{d:SampleData ItemCount=5}" Height="116" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="272" />
                    <Label Content="Output:" Margin="0,9,293,0" VerticalAlignment="Top" Padding="0,0,0,0" HorizontalAlignment="Right" Width="40"/>
                    <Label Content="Input:" HorizontalAlignment="Right" Margin="0,0,303,146" VerticalAlignment="Bottom" Padding="0,0,0,0"/>
                    <Label Content="List Midi 1 Ports&#xD;&#xA;using Endpoint Watcher" HorizontalAlignment="Right" Margin="0,30,400,0" VerticalAlignment="Top" Padding="0,0,0,0"/>
                    <Button x:Name="BtnTest" Content="Dbg Test" HorizontalAlignment="Left" Margin="315,336,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="Ti_IO_Test" Header="IO Test">
                <Grid>
                    <ComboBox x:Name="CmbInputSelector" HorizontalAlignment="Left" Margin="426,40,0,0" VerticalAlignment="Top" Width="200"/>
                    <Label Content="Input:" HorizontalAlignment="Left" Margin="426,19,0,0" VerticalAlignment="Top" Padding="0,0,0,0"/>
                    <Label Content="Output:" HorizontalAlignment="Left" Margin="25,19,0,0" VerticalAlignment="Top" Padding="0,0,0,0"/>
                    <ComboBox x:Name="CmbOutputSelector" HorizontalAlignment="Left" Margin="25,40,0,0" VerticalAlignment="Top" Width="200"/>
                    <TextBox x:Name="TbOutputData" HorizontalAlignment="Left" Margin="25,293,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="325" Height="210" IsReadOnly="True" Background="#FFF7F7F7" VerticalScrollBarVisibility="Auto"/>
                    <TextBox x:Name="TbInputData" Margin="422,194,48,53" TextWrapping="Wrap" IsReadOnly="True" Background="#FFF7F7F7" VerticalScrollBarVisibility="Auto" UndoLimit="0" FontFamily="Consolas"/>
                    <CheckBox x:Name="CbFilterTimingClock" Content="Filter Timing-Clock" HorizontalAlignment="Left" Margin="422,108,0,0" VerticalAlignment="Top"/>
                    <CheckBox x:Name="CbFilterActiveSensing" Content="Filter Active Sensing" HorizontalAlignment="Left" Margin="576,108,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="Btn_ID_Request" Content="ID Request" HorizontalAlignment="Left" Margin="25,258,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="Btn_GM_On" Content="GM On" HorizontalAlignment="Left" Margin="25,219,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="BtnCloseSelectedOutput" Content="Close" HorizontalAlignment="Left" Margin="274,41,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="BtnCloseSelectedInput" Content="Close" HorizontalAlignment="Left" Margin="693,41,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="BtnSendNote" Content="Send Note" HorizontalAlignment="Left" Margin="125,116,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="BtnClearTbInputData" Content="Clear" Margin="0,169,48,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="40"/>
                    <Button x:Name="BtnClearTbOutputData" Content="Clear" Margin="310,268,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="40"/>
                    <Button x:Name="BtnSysExTest" Content="SysEx Test Values" HorizontalAlignment="Left" Margin="148,204,0,0" VerticalAlignment="Top"/>
                    <Slider x:Name="SldSysExNumValues" HorizontalAlignment="Left" Margin="141,179,0,0" VerticalAlignment="Top" Width="120" Maximum="130" Value="5" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"/>
                    <TextBox x:Name="TbSldSysExNumValues" HorizontalAlignment="Left" Margin="263,205,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="44" IsReadOnly="True" Text="{Binding Value, ElementName=SldSysExNumValues}" HorizontalContentAlignment="Center"/>
                    <Label Content="count" HorizontalAlignment="Left" Margin="270,180,0,0" VerticalAlignment="Top" Padding="0,0,0,0"/>



                </Grid>
            </TabItem>


        </TabControl>
    </Grid>
</Window>
